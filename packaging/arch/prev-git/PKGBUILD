# Maintainer: Scramble Tools <https://github.com/scrambletools>
pkgname=prev-git
pkgver=1.0.0.r0.gdc1a8df
pkgrel=1
pkgdesc='View, mark up and sign PDFs and images (latest development)'
arch=('x86_64' 'aarch64' 'riscv64')
url='https://github.com/scrambletools/prev'
license=('AGPL-3.0-or-later')
depends=('fontconfig' 'gcc-libs' 'glibc' 'libxkbcommon' 'vulkan-icd-loader' 'wayland')
makedepends=('cargo' 'clang' 'git' 'pkgconf')
optdepends=('wl-clipboard: copy and paste images'
            'libheif: HEIC and AVIF images'
            'curl: pictures dropped from a browser as a web address'
            'cups: printing to a printer'
            'xdg-desktop-portal-gtk: the print dialog, where the desktop portal has none'
            'libx11: running under X11'
            'libxcursor: running under X11'
            'libxi: running under X11')
provides=('prev')
conflicts=('prev')
# MuPDF's C code is linked by Rust's linker, which cannot read GCC's LTO
# objects.
options=('!lto')
install=prev.install
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    git describe --long --tags --abbrev=7 2>/dev/null \
        | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g' \
        || printf '1.0.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    export PREV_PRODUCTION=1
    cargo build --frozen --release -p prev
}

check() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --workspace
}

package() {
    cd "$pkgname"
    scripts/dist-install.sh target/release/prev "$pkgdir" /usr
}
